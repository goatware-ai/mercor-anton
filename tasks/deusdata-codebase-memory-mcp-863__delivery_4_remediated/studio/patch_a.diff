+/* @vitest-environment jsdom */
+import "@testing-library/jest-dom/vitest";
+import { fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { NodeDetailPanel } from "./NodeDetailPanel";
+import * as rpc from "../api/rpc";
+import type { GraphNode } from "../lib/types";
+
+describe("NodeDetailPanel", () => {
+  afterEach(() => {
+    vi.restoreAllMocks();
+  });
+
+  describe("Show code", () => {
+    it("renders Show code button when node has metadata and displays source code safely as literal text", async () => {
+      const maliciousHtmlSource = `<script>window.pwned = true;</script>\n<img src="x" onerror="alert(1)" />\n<div class="danger">Hello & World</div>`;
+
+      const callToolSpy = vi.spyOn(rpc, "callTool").mockResolvedValue({
+        source: maliciousHtmlSource,
+      });
+
+      const node: GraphNode = {
+        id: 1,
+        x: 0,
+        y: 0,
+        z: 0,
+        label: "Function",
+        name: "testFunc",
+        qualified_name: "pkg.testFunc",
+        file_path: "src/@components/test.ts",
+        size: 1,
+        color: "#fff",
+      };
+
+      const { container } = render(
+        <NodeDetailPanel
+          node={node}
+          allNodes={[node]}
+          allEdges={[]}
+          project="my-project"
+          onClose={() => {}}
+          onNavigate={() => {}}
+        />,
+      );
+
+      const showCodeBtn = screen.getByRole("button", { name: "Show code" });
+      expect(showCodeBtn).toBeInTheDocument();
+
+      fireEvent.click(showCodeBtn);
+
+      await waitFor(() => {
+        expect(callToolSpy).toHaveBeenCalledWith("get_code_snippet", {
+          qualified_name: "pkg.testFunc",
+          project: "my-project",
+        });
+      });
+
+      // Wait for code to be displayed
+      const codeElement = await screen.findByText(/<script>window\.pwned = true;<\/script>/);
+      expect(codeElement).toBeInTheDocument();
+
+      // Ensure NO script tag or img DOM elements were created from the source code string
+      expect(container.querySelector("script")).toBeNull();
+      expect(container.querySelector("img")).toBeNull();
+      expect(container.querySelector("div.danger")).toBeNull();
+
+      // Verify exact literal text is present in the code block
+      expect(codeElement.textContent).toBe(maliciousHtmlSource);
+    });
+
+    it("does not render Show code button when node lacks code metadata", () => {
+      const nodeWithoutMetadata: GraphNode = {
+        id: 2,
+        x: 0,
+        y: 0,
+        z: 0,
+        label: "Folder",
+        name: "my_folder",
+        size: 1,
+        color: "#fff",
+      };
+
+      render(
+        <NodeDetailPanel
+          node={nodeWithoutMetadata}
+          allNodes={[nodeWithoutMetadata]}
+          allEdges={[]}
+          onClose={() => {}}
+          onNavigate={() => {}}
+        />,
+      );
+
+      expect(screen.queryByRole("button", { name: /Show code/i })).not.toBeInTheDocument();
+    });
+  });
+
+  describe("Open on GitHub link", () => {
+    it("renders Open on GitHub link with encoded file path, line range anchor, and security attributes", () => {
+      const node: GraphNode = {
+        id: 3,
+        x: 0,
+        y: 0,
+        z: 0,
+        label: "Function",
+        name: "specialFunc",
+        file_path: "src/@scope/my special file.ts",
+        start_line: 15,
+        end_line: 42,
+        size: 1,
+        color: "#fff",
+        git_remote: "https://github.com/org/repo.git",
+      };
+
+      render(
+        <NodeDetailPanel
+          node={node}
+          allNodes={[node]}
+          allEdges={[]}
+          onClose={() => {}}
+          onNavigate={() => {}}
+        />,
+      );
+
+      const link = screen.getByRole("link", { name: /Open on GitHub/i });
+      expect(link).toBeInTheDocument();
+
+      // Properly encodes @ as %40 and space as %20
+      expect(link).toHaveAttribute(
+        "href",
+        "https://github.com/org/repo/blob/main/src/%40scope/my%20special%20file.ts#L15-L42",
+      );
+
+      // Security attributes for external new tab link
+      expect(link).toHaveAttribute("target", "_blank");
+      expect(link).toHaveAttribute("rel", "noopener noreferrer");
+    });
+
+    it("handles SSH remote and single line anchor", () => {
+      const node: GraphNode = {
+        id: 4,
+        x: 0,
+        y: 0,
+        z: 0,
+        label: "Function",
+        name: "singleLineFunc",
+        file_path: "index.ts",
+        start_line: 10,
+        end_line: 10,
+        size: 1,
+        color: "#fff",
+      };
+
+      render(
+        <NodeDetailPanel
+          node={node}
+          allNodes={[node]}
+          allEdges={[]}
+          gitRemote="git@github.com:owner/project.git"
+          onClose={() => {}}
+          onNavigate={() => {}}
+        />,
+      );
+
+      const link = screen.getByRole("link", { name: /Open on GitHub/i });
+      expect(link).toBeInTheDocument();
+      expect(link).toHaveAttribute(
+        "href",
+        "https://github.com/owner/project/blob/main/index.ts#L10",
+      );
+    });
+
+    it("does not render Open on GitHub link when remote is unknown", () => {
+      const node: GraphNode = {
+        id: 5,
+        x: 0,
+        y: 0,
+        z: 0,
+        label: "Function",
+        name: "localFunc",
+        file_path: "src/local.ts",
+        size: 1,
+        color: "#fff",
+      };
+
+      render(
+        <NodeDetailPanel
+          node={node}
+          allNodes={[node]}
+          allEdges={[]}
+          onClose={() => {}}
+          onNavigate={() => {}}
+        />,
+      );
+
+      expect(screen.queryByRole("link", { name: /Open on GitHub/i })).not.toBeInTheDocument();
+    });
+  });
+});
