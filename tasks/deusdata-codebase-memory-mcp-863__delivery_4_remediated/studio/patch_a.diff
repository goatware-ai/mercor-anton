+    const SAMPLE_WITH_DEAD: GraphData = {
+      nodes: [
+        { id: 1, x: 0, y: 0, z: 0, label: "Function", name: "dead_fn", size: 1, color: "#fff" },
+        { id: 2, x: 1, y: 0, z: 0, label: "Function", name: "live_fn", size: 1, color: "#fff" },
+        { id: 3, x: 2, y: 0, z: 0, label: "Function", name: "caller_fn", size: 1, color: "#fff" },
+      ],
+      edges: [{ source: 3, target: 2, type: "CALLS" }],
+      total_nodes: 3,
+    };
+
+    mockLayoutFetch(SAMPLE_WITH_DEAD);
+
+    render(<GraphTab project="demo" />);
+
+    expect(await screen.findByText("Filters")).toBeInTheDocument();
+
+    // Node 1 (dead_fn) has no callers -> dead
+    // Node 3 (caller_fn) has no callers -> dead
+    // Total dead = 2 dead
+    expect(screen.getByText("2 dead")).toBeInTheDocument();
+
+    const deadToggle = screen.getByRole("button", { name: /Show only dead code/i });
+    expect(deadToggle).toBeInTheDocument();
+
+    // Initially all 3 nodes are shown
+    expect(screen.getByText("3 nodes / 1 edges")).toBeInTheDocument();
+    expect(screen.queryByText(/filtered from/i)).not.toBeInTheDocument();
+
+    // Toggle dead code filter
+    fireEvent.click(deadToggle);
+
+    // Now only 2 dead nodes are visible, and "filtered from 3" notice appears
+    expect(await screen.findByText("2 nodes / 0 edges")).toBeInTheDocument();
+    expect(screen.getByText("filtered from 3")).toBeInTheDocument();
+
+    // Toggle back
+    fireEvent.click(deadToggle);
+    expect(await screen.findByText("3 nodes / 1 edges")).toBeInTheDocument();
+    expect(screen.queryByText(/filtered from/i)).not.toBeInTheDocument();
+  });
 });
