diff --git a/graph-ui/src/lib/utils.ts b/graph-ui/src/lib/utils.ts
--- a/graph-ui/src/lib/utils.ts
+++ b/graph-ui/src/lib/utils.ts
@@ -1,6 +1,144 @@
 import { clsx, type ClassValue } from "clsx";
 import { twMerge } from "tailwind-merge";
+import type { GraphData, GraphEdge, GraphNode } from "./types";
 
 export function cn(...inputs: ClassValue[]) {
   return twMerge(clsx(inputs));
 }
+
+/**
+ * Determines whether an edge is a calling relationship.
+ */
+function isCallEdge(edge: GraphEdge): boolean {
+  if (!edge.type) return true;
+  const t = edge.type.toUpperCase();
+  return t === "CALLS" || t.includes("CALL");
+}
+
+/**
+ * Checks if a given graph node is dead code (a function with no callers, or marked dead).
+ */
+export function isDeadNode(node: GraphNode, allEdges: GraphEdge[] = []): boolean {
+  if (node.is_dead !== undefined) return Boolean(node.is_dead);
+  if (node.dead !== undefined) return Boolean(node.dead);
+
+  const isFunction = !node.label || node.label === "Function" || node.label === "Method";
+  if (!isFunction) return false;
+
+  const hasCaller = allEdges.some((e) => e.target === node.id && isCallEdge(e));
+  return !hasCaller;
+}
+
+/**
+ * Returns the set of dead node IDs across the entire GraphData (including linked projects).
+ */
+export function getDeadNodeIds(data: GraphData): Set<number> {
+  const allEdges: GraphEdge[] = [...data.edges];
+  if (data.linked_projects) {
+    for (const lp of data.linked_projects) {
+      allEdges.push(...lp.edges);
+      allEdges.push(...lp.cross_edges);
+    }
+  }
+
+  const calledNodeIds = new Set<number>();
+  for (const edge of allEdges) {
+    if (isCallEdge(edge)) {
+      calledNodeIds.add(edge.target);
+    }
+  }
+
+  const deadIds = new Set<number>();
+  const checkNode = (n: GraphNode) => {
+    if (n.is_dead !== undefined) {
+      if (n.is_dead) deadIds.add(n.id);
+    } else if (n.dead !== undefined) {
+      if (n.dead) deadIds.add(n.id);
+    } else {
+      const isFunc = !n.label || n.label === "Function" || n.label === "Method";
+      if (isFunc && !calledNodeIds.has(n.id)) {
+        deadIds.add(n.id);
+      }
+    }
+  };
+
+  for (const n of data.nodes) checkNode(n);
+  if (data.linked_projects) {
+    for (const lp of data.linked_projects) {
+      for (const n of lp.nodes) checkNode(n);
+    }
+  }
+
+  return deadIds;
+}
+
+/**
+ * Normalizes git remote URLs (SSH, HTTPS, git+, etc.) to standard GitHub repository URLs.
+ */
+export function normalizeGitHubRemoteUrl(remoteUrl: string): string | null {
+  if (!remoteUrl) return null;
+  let url = remoteUrl.trim().replace(/\.git$/, "");
+
+  const sshMatch = url.match(/^(?:ssh:\/\/)?git@github\.com[:/](.+)$/);
+  if (sshMatch) {
+    return `https://github.com/${sshMatch[1]}`;
+  }
+
+  url = url.replace(/^git\+/, "").replace(/^http:\/\//, "https://");
+  if (url.startsWith("github.com/")) {
+    return `https://${url}`;
+  }
+
+  if (/^https?:\/\//.test(url)) {
+    return url;
+  }
+
+  return null;
+}
+
+/**
+ * Builds a direct GitHub link to a file and line number range.
+ * Special characters in the file path (spaces, at-signs, etc.) are properly URL-encoded.
+ */
+export function buildGitHubUrl({
+  remoteUrl,
+  filePath,
+  startLine,
+  endLine,
+  branch = "main",
+}: {
+  remoteUrl: string;
+  filePath?: string;
+  startLine?: number;
+  endLine?: number;
+  branch?: string;
+}): string | null {
+  if (!remoteUrl || !filePath) return null;
+
+  const normalizedRemote = normalizeGitHubRemoteUrl(remoteUrl);
+  if (!normalizedRemote) return null;
+
+  const base = normalizedRemote.replace(/\/+$/, "");
+  const cleanPath = filePath.replace(/^(\.\/|\/)+/, "").replace(/\\/g, "/");
+  const encodedPath = cleanPath
+    .split("/")
+    .map((segment) => encodeURIComponent(segment))
+    .join("/");
+
+  let fileUrl: string;
+  if (base.includes("/blob/")) {
+    fileUrl = `${base}/${encodedPath}`;
+  } else {
+    fileUrl = `${base}/blob/${branch}/${encodedPath}`;
+  }
+
+  if (startLine !== undefined && startLine > 0) {
+    if (endLine !== undefined && endLine > startLine) {
+      fileUrl += `#L${startLine}-L${endLine}`;
+    } else {
+      fileUrl += `#L${startLine}`;
+    }
+  }
+
+  return fileUrl;
+}
