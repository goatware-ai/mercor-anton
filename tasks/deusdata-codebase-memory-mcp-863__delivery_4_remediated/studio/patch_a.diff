+import { describe, expect, it } from "vitest";
+import { buildGitHubUrl, getDeadNodeIds, isDeadNode, normalizeGitHubRemoteUrl } from "./utils";
+import type { GraphData, GraphNode } from "./types";
+
+describe("normalizeGitHubRemoteUrl", () => {
+  it("normalizes various GitHub remote formats", () => {
+    expect(normalizeGitHubRemoteUrl("https://github.com/foo/bar.git")).toBe(
+      "https://github.com/foo/bar",
+    );
+    expect(normalizeGitHubRemoteUrl("git@github.com:foo/bar.git")).toBe(
+      "https://github.com/foo/bar",
+    );
+    expect(normalizeGitHubRemoteUrl("ssh://git@github.com/foo/bar.git")).toBe(
+      "https://github.com/foo/bar",
+    );
+    expect(normalizeGitHubRemoteUrl("github.com/foo/bar")).toBe(
+      "https://github.com/foo/bar",
+    );
+  });
+});
+
+describe("buildGitHubUrl", () => {
+  it("correctly encodes special characters in file paths and builds line anchors", () => {
+    const url = buildGitHubUrl({
+      remoteUrl: "https://github.com/org/repo",
+      filePath: "src/@components/My Button.tsx",
+      startLine: 12,
+      endLine: 25,
+    });
+    expect(url).toBe(
+      "https://github.com/org/repo/blob/main/src/%40components/My%20Button.tsx#L12-L25",
+    );
+  });
+
+  it("handles single line without range", () => {
+    const url = buildGitHubUrl({
+      remoteUrl: "https://github.com/org/repo",
+      filePath: "main.go",
+      startLine: 42,
+    });
+    expect(url).toBe("https://github.com/org/repo/blob/main/main.go#L42");
+  });
+
+  it("returns null when remote or file path is missing", () => {
+    expect(buildGitHubUrl({ remoteUrl: "", filePath: "foo.js" })).toBeNull();
+    expect(buildGitHubUrl({ remoteUrl: "https://github.com/org/repo", filePath: "" })).toBeNull();
+  });
+});
+
+describe("dead code helpers", () => {
+  it("identifies functions without callers as dead code", () => {
+    const n1: GraphNode = { id: 1, label: "Function", name: "dead", x: 0, y: 0, z: 0, size: 1, color: "#fff" };
+    const n2: GraphNode = { id: 2, label: "Function", name: "live", x: 0, y: 0, z: 0, size: 1, color: "#fff" };
+    const edges = [{ source: 1, target: 2, type: "CALLS" }];
+
+    expect(isDeadNode(n1, edges)).toBe(true);
+    expect(isDeadNode(n2, edges)).toBe(false);
+  });
+
+  it("respects explicit is_dead / dead metadata flags", () => {
+    const n1: GraphNode = { id: 1, label: "Function", name: "f", x: 0, y: 0, z: 0, size: 1, color: "#fff", is_dead: true };
+    const n2: GraphNode = { id: 2, label: "Function", name: "f", x: 0, y: 0, z: 0, size: 1, color: "#fff", dead: false };
+
+    expect(isDeadNode(n1, [])).toBe(true);
+    expect(isDeadNode(n2, [])).toBe(false);
+  });
+
+  it("calculates dead node IDs across graph data", () => {
+    const data: GraphData = {
+      nodes: [
+        { id: 1, label: "Function", name: "f1", x: 0, y: 0, z: 0, size: 1, color: "#fff" },
+        { id: 2, label: "Function", name: "f2", x: 0, y: 0, z: 0, size: 1, color: "#fff" },
+        { id: 3, label: "Class", name: "C1", x: 0, y: 0, z: 0, size: 1, color: "#fff" },
+      ],
+      edges: [{ source: 1, target: 2, type: "CALLS" }],
+      total_nodes: 3,
+    };
+
+    const deadIds = getDeadNodeIds(data);
+    expect(deadIds.has(1)).toBe(true);
+    expect(deadIds.has(2)).toBe(false);
+    expect(deadIds.has(3)).toBe(false);
+  });
+});
