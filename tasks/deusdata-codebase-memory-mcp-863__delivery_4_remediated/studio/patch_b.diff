+import { describe, expect, it } from "vitest";
+import { buildGithubFileUrl, encodeFilePath, parseGitRemote } from "./github";
+
+describe("parseGitRemote", () => {
+  it("parses scp-style remotes", () => {
+    expect(parseGitRemote("git@github.com:DeusData/codebase-memory-mcp.git")).toEqual({
+      host: "github.com",
+      slug: "DeusData/codebase-memory-mcp",
+    });
+  });
+
+  it("parses https remotes with and without the .git suffix", () => {
+    expect(parseGitRemote("https://github.com/foo/bar.git")).toEqual({
+      host: "github.com",
+      slug: "foo/bar",
+    });
+    expect(parseGitRemote("https://github.com/foo/bar")).toEqual({
+      host: "github.com",
+      slug: "foo/bar",
+    });
+  });
+
+  it("strips embedded credentials and ports from the authority", () => {
+    expect(parseGitRemote("https://token@github.com/foo/bar.git")?.host).toBe("github.com");
+    expect(parseGitRemote("ssh://git@github.com:22/foo/bar.git")).toEqual({
+      host: "github.com",
+      slug: "foo/bar",
+    });
+  });
+
+  it("rejects unusable remotes", () => {
+    expect(parseGitRemote("")).toBeNull();
+    expect(parseGitRemote(null)).toBeNull();
+    expect(parseGitRemote(undefined)).toBeNull();
+    /* No owner/repo path. */
+    expect(parseGitRemote("https://github.com/onlyowner")).toBeNull();
+    /* Unsupported scheme. */
+    expect(parseGitRemote("file:///srv/git/foo/bar.git")).toBeNull();
+  });
+});
+
+describe("encodeFilePath", () => {
+  it("preserves separators but escapes URL-significant characters", () => {
+    expect(encodeFilePath("src/ui/http_server.c")).toBe("src/ui/http_server.c");
+    expect(encodeFilePath("src/my file.ts")).toBe("src/my%20file.ts");
+    expect(encodeFilePath("src/@scope/pkg.ts")).toBe("src/%40scope/pkg.ts");
+    expect(encodeFilePath("src/a#b?c.ts")).toBe("src/a%23b%3Fc.ts");
+    expect(encodeFilePath("src/100%/x.ts")).toBe("src/100%25/x.ts");
+  });
+
+  it("drops empty segments from leading or doubled slashes", () => {
+    expect(encodeFilePath("/src//a.ts")).toBe("src/a.ts");
+  });
+});
+
+describe("buildGithubFileUrl", () => {
+  const remote = "git@github.com:DeusData/codebase-memory-mcp.git";
+
+  it("builds a blob URL with a line range anchor", () => {
+    expect(
+      buildGithubFileUrl({
+        remote,
+        filePath: "src/ui/layout3d.c",
+        startLine: 10,
+        endLine: 42,
+      }),
+    ).toBe(
+      "https://github.com/DeusData/codebase-memory-mcp/blob/HEAD/src/ui/layout3d.c#L10-L42",
+    );
+  });
+
+  it("encodes special characters in the file path", () => {
+    const url = buildGithubFileUrl({
+      remote,
+      filePath: "src/my file@2x/thing.ts",
+      startLine: 3,
+      endLine: 5,
+    });
+    expect(url).toBe(
+      "https://github.com/DeusData/codebase-memory-mcp/blob/HEAD/src/my%20file%402x/thing.ts#L3-L5",
+    );
+    /* The raw space and at-sign must not survive into the URL. */
+    expect(url).not.toContain(" ");
+    expect(url).not.toContain("@2x");
+  });
+
+  it("collapses a single-line or degenerate range to one anchor", () => {
+    expect(
+      buildGithubFileUrl({ remote, filePath: "a.ts", startLine: 7, endLine: 7 }),
+    ).toMatch(/#L7$/);
+    /* end < start is nonsense — fall back to the start line only. */
+    expect(
+      buildGithubFileUrl({ remote, filePath: "a.ts", startLine: 9, endLine: 2 }),
+    ).toMatch(/#L9$/);
+  });
+
+  it("omits the anchor when no usable line number is known", () => {
+    expect(buildGithubFileUrl({ remote, filePath: "a.ts" })).not.toContain("#");
+    expect(buildGithubFileUrl({ remote, filePath: "a.ts", startLine: 0 })).not.toContain("#");
+  });
+
+  it("honours an explicit ref", () => {
+    expect(
+      buildGithubFileUrl({ remote, filePath: "a.ts", ref: "feature/x y" }),
+    ).toContain("/blob/feature%2Fx%20y/a.ts");
+  });
+
+  it("returns null for non-GitHub hosts and unusable inputs", () => {
+    expect(buildGithubFileUrl({ remote: "git@gitlab.com:a/b.git", filePath: "a.ts" })).toBeNull();
+    expect(buildGithubFileUrl({ remote: "", filePath: "a.ts" })).toBeNull();
+    expect(buildGithubFileUrl({ remote, filePath: "" })).toBeNull();
+  });
+
+  it("supports GitHub Enterprise hosts", () => {
+    expect(
+      buildGithubFileUrl({ remote: "git@github.acme.com:a/b.git", filePath: "a.ts" }),
+    ).toBe("https://github.acme.com/a/b/blob/HEAD/a.ts");
+  });
+});
