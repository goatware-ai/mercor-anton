+/* Is this label a callable that dead-code analysis applies to? Only callables
+ * can be "never called"; Files, Modules and Routes have no CALLS edges at all
+ * and would otherwise all be reported as dead. */
+static bool label_is_callable(const char *label) {
+    if (!label)
+        return false;
+    return strcmp(label, "Function") == 0 || strcmp(label, "Method") == 0 ||
+           strcmp(label, "Constructor") == 0;
+}
+
+/* Read the indexer's "$.is_entry_point" flag out of a node's properties JSON.
+ * Entry points (main, HTTP handlers, exported CLI commands, ...) legitimately
+ * have no in-repo caller, so they must not be reported as dead code. This
+ * mirrors the exclude_entry_points semantics used by search_graph and the
+ * `Dead code` recipe in src/cli/cli.c. */
+static bool node_is_entry_point(const char *properties_json) {
+    if (!properties_json || !properties_json[0])
+        return false;
+    yyjson_doc *doc = yyjson_read(properties_json, strlen(properties_json), 0);
+    if (!doc)
+        return false;
+    yyjson_val *root = yyjson_doc_get_root(doc);
+    yyjson_val *flag = yyjson_obj_get(root, "is_entry_point");
+    bool is_entry = flag && yyjson_is_true(flag);
+    yyjson_doc_free(doc);
+    return is_entry;
+}
